# KaNun Monitoring — Stripe Checkout Configuration
# 
# Add these to Netlify Dashboard > Site settings > Build & deploy > Environment
#

# Stripe Live Secret Key (from Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
# Create a webhook endpoint at https://kanunmonitoring.com/.netlify/functions/webhooks-stripe
# Then copy the "Signing secret" from the webhook configuration
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
